# MongoDB Atlas connection string.
# Copy this file to .env.local and fill in your real credentials.
# .env.local is gitignored and must never be committed.
MONGODB_URI="Paste your mongo url here"

# Groq API key for the AI travel chatbot (https://console.groq.com).
# Server-only: it is read inside app/api/chat/route.js, which never runs in the
# browser. Do NOT prefix it with NEXT_PUBLIC_ - that would bundle it into the
# client JavaScript and expose it to anyone who opens devtools.
GROQ_API_KEY="Paste your Groq API key here"

# --- Firebase Authentication (admin dashboard) ---
#
# The three NEXT_PUBLIC_ values below are MEANT to be public: the Firebase
# client SDK runs in the browser, and these identify the project rather than
# authorise anything. Security comes from Firebase Auth plus our own
# server-side token verification, not from hiding them.
#
# From: Firebase Console -> Project settings -> General -> Your apps -> Config
NEXT_PUBLIC_FIREBASE_API_KEY="Paste apiKey here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="Paste authDomain here"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="Paste projectId here"

# The three below are SERVER ONLY. The private key grants full admin access to
# the Firebase project, so it must never get a NEXT_PUBLIC_ prefix.
#
# From: Firebase Console -> Project settings -> Service accounts ->
#       Generate new private key (downloads a .json file)
#
# FIREBASE_PRIVATE_KEY is the fiddly one. Copy the private_key value exactly as
# it appears in the JSON, keeping every \n as the two characters they are, and
# wrap it in double quotes. Do NOT paste real line breaks, and do NOT include
# the trailing comma from the JSON line - that comma stops the env loader
# recognising the value as quoted, which breaks the key.
#
# Run `node scripts/checkFirebaseKey.mjs` to check it without printing it.
FIREBASE_PROJECT_ID="Paste project_id here"
FIREBASE_CLIENT_EMAIL="Paste client_email here"
FIREBASE_PRIVATE_KEY="Paste private_key here, quoted, with \n intact"
