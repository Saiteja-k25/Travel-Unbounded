# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Firebase service account keys. These are downloaded as a .json file and
# contain a private key that grants full admin access to the project, so a
# stray copy left in the repo would be a serious leak. The values belong in
# .env.local, never in a committed file.
*serviceaccount*.json
*service-account*.json
firebase-adminsdk*.json
*-firebase-adminsdk-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI assistant config (AGENTS.md is regenerated by `next dev`)
AGENTS.md
CLAUDE.md
.claude/
